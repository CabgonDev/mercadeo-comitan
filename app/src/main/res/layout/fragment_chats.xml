<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    tools:context=".Fragmentos.FragmentChats">

    <!-- Buscador -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="6dp"
        android:backgroundTint="@android:color/transparent">

        <EditText
            android:id="@+id/EtBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:hint="Buscar chat..."
            android:inputType="text"
            android:drawableStart="@drawable/ic_buscar"
            android:drawablePadding="10dp"
            android:background="@color/set_text"
            android:textSize="15sp"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Texto de vacío -->
    <TextView
        android:id="@+id/TxtVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay chats disponibles"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/gris_medio"
        android:visibility="gone"
        android:padding="20dp"
        android:fontFamily="sans-serif-medium"/>

    <!-- Lista de chats -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatsRv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_chats"
        android:clipToPadding="false"
        android:paddingBottom="12dp"/>

</androidx.appcompat.widget.LinearLayoutCompat>
