<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:contentPadding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/Txt_agregar"
                    android:textColor="@color/brand_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/comentarios_dialog_descripcion"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/Ib_cerrar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_favorite_button"
                android:contentDescription="@string/accion_cerrar"
                android:padding="12dp"
                android:src="@drawable/ic_cerrar_dialog"
                app:tint="@color/brand_navy" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TIL_comentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/Et_agregar_comentario"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/brand_teal"
            app:counterEnabled="true"
            app:counterMaxLength="500">

            <EditText
                android:id="@+id/Et_agregar_comentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minHeight="120dp"
                android:paddingTop="14dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/Btn_comentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="50dp"
            android:text="@string/Btn_comentar"
            android:textAllCaps="false"
            android:textColor="@color/md_theme_onPrimary"
            android:textSize="15sp"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="15dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
