<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="56dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Avatar opcional del otro usuario -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:civ_border_width="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardBurbuja"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Burbuja del receptor (izquierda) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBurbuja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="false"
        android:clickable="false"
        android:focusable="false"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/chat_bubble_in"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp">

            <!-- Imagen opcional -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFoto"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/Shape.Bubble.Image"
                android:contentDescription="@string/app_name" />

            <!-- Texto del mensaje -->
            <TextView
                android:id="@+id/tvMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:text="Mensaje del otro usuario, soporta varias líneas."
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:maxWidth="260dp" />

            <!-- Fila: hora -->
            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:45 p. m."
                android:textSize="11sp"
                android:textColor="#99000000"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
