<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo2"
    tools:context=".PedidoActivity">

    <!-- Toolbar Superior -->
    <LinearLayout
        android:id="@+id/ToolbarPedidoRl"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/mi_color"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/tvPedidoEncabezado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Pedido local"
                android:textColor="@color/brand_navy"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPedido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ToolbarPedidoRl"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp">

            <!-- Tarjeta Principal de Resumen del Pedido -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPedidoRolChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_blue"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Solicitud de compra"
                            android:textColor="@color/md_theme_onSecondaryContainer"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPedidoEstadoChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_amber"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Por enviar"
                            android:textColor="@color/md_theme_onTertiaryContainer"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPedidoTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Producto"
                        android:textColor="@color/brand_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPedidoPrecio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="$0 MXN"
                        android:textColor="@color/brand_teal"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPedidoEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Estado del pedido"
                        android:textColor="@color/gris_oscuro"
                        android:textSize="14sp" />

                    <!-- Resumen adicional para órdenes existentes -->
                    <LinearLayout
                        android:id="@+id/llDetallesExtraOrden"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/md_theme_surfaceContainerLow"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvPedidoMetodoResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/brand_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Método de pago: Contra entrega en Comitán" />

                        <TextView
                            android:id="@+id/tvPedidoFechaEntrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/brand_teal"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="Entrega programada: 10/11/2026 04:00 PM"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Atajos a publicación y chat -->
                    <LinearLayout
                        android:id="@+id/llAtajosOrden"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerAnuncioPedido"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Ver anuncio"
                            android:textAllCaps="false"
                            android:textColor="@color/brand_navy"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_anuncios"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:iconTint="@color/brand_navy"
                            app:strokeColor="@color/md_theme_outlineVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChatContraparte"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Abrir chat"
                            android:textAllCaps="false"
                            android:textColor="@color/brand_teal"
                            android:textSize="12sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_op_chat"
                            app:iconGravity="textStart"
                            app:iconSize="16dp"
                            app:iconTint="@color/brand_teal"
                            app:strokeColor="@color/brand_teal" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de Método de Pago y Datos de Transferencia -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMetodoPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTituloMetodoPago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Elige cómo pagar"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/brand_navy"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgMetodoPago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rbContraEntrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Contra entrega en Comitán"
                            android:textColor="@color/negro_oscuro" />

                        <RadioButton
                            android:id="@+id/rbTransferencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transferencia bancaria al vendedor"
                            android:textColor="@color/negro_oscuro" />
                    </RadioGroup>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDatosTransferencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/md_theme_surfaceContainerLow"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/md_theme_outlineVariant"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvBancoTransferencia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Banco"
                                android:textColor="@color/brand_navy"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvTitularTransferencia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/gris_oscuro"
                                android:textSize="13sp"
                                android:visibility="gone"
                                tools:text="Titular: Nombre del Vendedor"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/tvClabeTransferencia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="CLABE"
                                android:textColor="@color/brand_navy"
                                android:textIsSelectable="true"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopiarClabe"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="10dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Copiar CLABE"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_teal"
                                app:cornerRadius="10dp"
                                app:strokeColor="@color/brand_teal" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de Punto de Encuentro -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPuntoEncuentro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Punto de encuentro"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/brand_navy"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAyudaPuntoEncuentro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sugiere un lugar público y céntrico en Comitán para la entrega."
                        android:textColor="@color/gris_texto"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPuntoEncuentro"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Punto de encuentro en Comitán"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/brand_teal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPuntoEncuentro"
                            style="@style/Widget.MercadeoComitan.TextInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLength="120" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón de Enviar Solicitud (Nueva Orden) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarSolicitud"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="Enviar solicitud"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_teal"
                app:cornerRadius="16dp" />

            <!-- Tarjeta de Acciones del Pedido (Orden Existente) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccionesOrden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/md_theme_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seguimiento y acciones"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/brand_navy"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGuiaAccionOrden"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/gris_texto"
                        android:textSize="13sp"
                        tools:text="Revisa los detalles de la operación." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccionOrden1"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/brand_teal"
                        app:cornerRadius="14dp"
                        tools:text="Aceptar solicitud"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccionOrden2"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:textAllCaps="false"
                        android:textColor="@color/error_color"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/error_color"
                        tools:text="Cancelar pedido"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón de Calificar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalificar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Calificar operación"
                android:textAllCaps="false"
                android:textColor="@color/brand_navy"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/mi_color"
                app:cornerRadius="16dp"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
