<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gris_claro"
    app:strokeWidth="0.5dp"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <!-- Imagen perfil -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/IvPerfil"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/img_perfil"
            android:scaleType="centerCrop"
            app:civ_border_color="@color/gris_claro"
            app:civ_border_width="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Nombre -->
        <TextView
            android:id="@+id/TvNombres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Usuario"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/IvPerfil"
            app:layout_constraintTop_toTopOf="@id/IvPerfil"
            app:layout_constraintEnd_toStartOf="@id/TvFecha"
            app:layout_constraintHorizontal_bias="0"
            android:layout_marginStart="10dp"/>

        <!-- Fecha / hora -->
        <TextView
            android:id="@+id/TvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45 PM"
            android:textSize="12sp"
            android:textColor="@color/gris_oscuro"
            app:layout_constraintTop_toTopOf="@id/TvNombres"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Último mensaje -->
        <TextView
            android:id="@+id/TvUltimoMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Último mensaje..."
            android:textSize="14sp"
            android:textColor="@color/gris_oscuro"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/TvNombres"
            app:layout_constraintStart_toStartOf="@id/TvNombres"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="2dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
