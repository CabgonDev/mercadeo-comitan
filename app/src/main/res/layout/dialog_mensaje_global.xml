<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de administración"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sección mensaje global -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje global"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/swMensajeActivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrar al abrir la app" />

        <EditText
            android:id="@+id/etTituloMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título"
            android:inputType="textCapSentences"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etCuerpoMensaje"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:hint="Mensaje a mostrar"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/progressMsg"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGuardarMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar mensaje global"
            android:layout_marginTop="12dp" />

        <!-- aquí después metemos las otras opciones: bloquear usuario, hacer admin, etc. -->

    </LinearLayout>
</ScrollView>

