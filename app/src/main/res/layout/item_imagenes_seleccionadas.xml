<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_margin="3dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/item_imagen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Foto seleccionada"
            android:scaleType="centerCrop"
            android:src="@drawable/item_imagen" />

        <ImageButton
            android:id="@+id/cerrar_item"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@android:color/white"
            android:contentDescription="Eliminar foto"
            android:padding="6dp"
            android:src="@drawable/cerrar"
            android:elevation="4dp"
            app:tint="@color/error_color" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
